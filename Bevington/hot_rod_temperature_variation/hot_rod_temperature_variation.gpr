with "config/hot_rod_temperature_variation_config.gpr";

project Hot_Rod_Temperature_Variation is

   for Source_Dirs use ("src/", "config/", "../common/");
   for Object_Dir use "obj/" & Hot_Rod_Temperature_Variation_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use ".";
   for Main use ("hot_rod_temperature.adb");

   package Compiler is
      for Default_Switches ("Ada") use Hot_Rod_Temperature_Variation_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Hot_Rod_Temperature_Variation;
